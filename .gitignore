# Bundles/exports de trabalho — não versionar
*.zip

# Segredos locais REAIS (o SEC-015 da instância usa valores fictícios plantados,
# esses sim entram versionados de propósito). Nunca versionar credenciais de verdade:
.env
.env.*
*.local.php

# Área de trabalho dos runs: pacotes montados, entregas dos modelos, relatórios
# mecânicos e scorecards. Tudo derivado — nada aqui é fonte (os scorecards oficiais
# publicados vão à parte).
/runs/
instances/*/runs/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
